{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jm-qqbot",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-18",
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "vars": {
    "QQBOT_ALLOWED_GROUP_OPENIDS": "",
    "QQBOT_JM_ALLOWED_USER_OPENIDS": "",
    "QQBOT_JM_BATCH_MAX_ITEMS": "3",
    "QQBOT_JM_MAX_BYTES": "83886080",
    "QQBOT_JM_TIMEOUT_SECONDS": "1200",
    "QQBOT_JM_UPLOAD_TIMEOUT_SECONDS": "900",
    "QQBOT_JM_INSPECT_TIMEOUT_SECONDS": "30",
    "QQBOT_JM_FAILURE_RETAIN_SECONDS": "1800"
  },
  "containers": [
    {
      "class_name": "JMBotContainer",
      "image": "../Dockerfile",
      "max_instances": 1,
      "instance_type": "basic"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "JM_BOT",
        "class_name": "JMBotContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["JMBotContainer"]
    }
  ]
}
